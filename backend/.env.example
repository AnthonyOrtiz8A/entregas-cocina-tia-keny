# Copia este archivo como .env y llena los valores
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
# Orígenes permitidos (CORS), separados por coma
FRONTEND_URL="http://localhost:5173"
PORT=8787
# Notificaciones push (opcional). Genera claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Debe empezar con https:// o mailto:
VAPID_SUBJECT="https://tu-frontend.vercel.app"
# Clave para el cron externo que revisa entregas atrasadas (opcional)
CRON_SECRET=""
